  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "tags",
    "sidebar"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "author": "Zhao Xin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenzhao/dsh-plugin-session-tags.git"
  },
  "homepage": "https://github.com/owenzhao/dsh-plugin-session-tags#readme",
  "bugs": {
    "url": "https://github.com/owenzhao/dsh-plugin-session-tags/issues"
  },
